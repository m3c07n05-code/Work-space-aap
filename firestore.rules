rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validation Blueprints ---
    function isValidUserPublic(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'photoUrl', 'createdAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        (!data.keys().hasAny(['photoUrl']) || (data.photoUrl is string && data.photoUrl.size() <= 512)) &&
        data.createdAt is timestamp;
    }

    function isValidUserPrivate(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.updatedAt is timestamp;
    }

    function isValidCrdScope(data, userId, scopeId) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'gate', 'rule', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'title', 'gate', 'rule', 'status', 'updatedAtLabel', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.id == scopeId &&
        isValidId(data.ownerId) &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 240 &&
        data.gate is string && data.gate.size() >= 1 && data.gate.size() <= 64 &&
        data.rule is string && data.rule.size() >= 1 && data.rule.size() <= 2000 &&
        data.status in ['ACTIVE_SYNCED', 'PENDING_DEPLOY', 'DRAFT'] &&
        (!data.keys().hasAny(['updatedAtLabel']) || (data.updatedAtLabel is string && data.updatedAtLabel.size() <= 64)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidChatSession(data, userId, chatId) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'roleId', 'modelId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'title', 'roleId', 'modelId', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.id == chatId &&
        isValidId(data.ownerId) &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.roleId in ['deep', 'complex', 'general', 'fast'] &&
        data.modelId is string && data.modelId.size() >= 1 && data.modelId.size() <= 64 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, userId, chatId, messageId) {
      return data.keys().hasAll(['id', 'ownerId', 'sessionId', 'role', 'text', 'createdAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'sessionId', 'role', 'text', 'modelUsed', 'createdAt']) &&
        isValidId(data.id) &&
        data.id == messageId &&
        isValidId(data.ownerId) &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        isValidId(data.sessionId) &&
        data.sessionId == chatId &&
        data.role in ['user', 'model'] &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 12000 &&
        (!data.keys().hasAny(['modelUsed']) || (data.modelUsed is string && data.modelUsed.size() <= 64)) &&
        data.createdAt is timestamp;
    }

    function isValidAuditPayload(data, userId, logId) {
      return data.keys().hasAll(['id', 'ownerId', 'action', 'statusCode', 'latencyMs', 'createdAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'action', 'statusCode', 'latencyMs', 'createdAt']) &&
        isValidId(data.id) &&
        data.id == logId &&
        isValidId(data.ownerId) &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 128 &&
        data.statusCode is int &&
        data.latencyMs is int &&
        data.createdAt is timestamp;
    }

    // --- Collection Rules ---

    // Public non-PII user display metadata
    match /users/{userId}/public/profile {
      allow get: if isValidId(userId) && isVerifiedOwner(userId);
      allow create: if isValidId(userId) && isVerifiedOwner(userId) &&
        isValidUserPublic(incoming(), userId) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(userId) && isVerifiedOwner(userId) &&
        isValidUserPublic(incoming(), userId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().uid == existing().uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl']);
      allow delete: if false;
    }

    // Strictly isolated private PII (verified email)
    match /users/{userId}/private/info {
      allow get: if isValidId(userId) && isVerifiedOwner(userId);
      allow create: if isValidId(userId) && isVerifiedOwner(userId) &&
        isValidUserPrivate(incoming(), userId) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isVerifiedOwner(userId) &&
        isValidUserPrivate(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
      allow delete: if false;
    }

    // CRD Scope Items per user
    match /users/{userId}/scopes/{scopeId} {
      allow get: if isValidId(userId) && isValidId(scopeId) && isVerifiedOwner(userId);
      allow list: if isValidId(userId) && isVerifiedOwner(userId) && existing().ownerId == request.auth.uid;
      allow create: if isValidId(userId) && isValidId(scopeId) && isVerifiedOwner(userId) &&
        isValidCrdScope(incoming(), userId, scopeId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isValidId(scopeId) && isVerifiedOwner(userId) &&
        isValidCrdScope(incoming(), userId, scopeId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().ownerId == existing().ownerId &&
        incoming().id == existing().id &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'gate', 'rule', 'status', 'updatedAtLabel', 'updatedAt']);
      allow delete: if isValidId(userId) && isValidId(scopeId) && isVerifiedOwner(userId) && existing().ownerId == request.auth.uid;
    }

    // Multi-turn Gemini Chat Sessions per user
    match /users/{userId}/chats/{chatId} {
      allow get: if isValidId(userId) && isValidId(chatId) && isVerifiedOwner(userId);
      allow list: if isValidId(userId) && isVerifiedOwner(userId) && existing().ownerId == request.auth.uid;
      allow create: if isValidId(userId) && isValidId(chatId) && isVerifiedOwner(userId) &&
        isValidChatSession(incoming(), userId, chatId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isValidId(chatId) && isVerifiedOwner(userId) &&
        isValidChatSession(incoming(), userId, chatId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().ownerId == existing().ownerId &&
        incoming().id == existing().id &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'roleId', 'modelId', 'updatedAt']);
      allow delete: if isValidId(userId) && isValidId(chatId) && isVerifiedOwner(userId) && existing().ownerId == request.auth.uid;

      // Messages Subcollection (Master Gate: checks parent ChatSession ownership)
      match /messages/{messageId} {
        allow get: if isValidId(userId) && isValidId(chatId) && isValidId(messageId) &&
          isVerifiedOwner(userId) &&
          get(/databases/$(database)/documents/users/$(userId)/chats/$(chatId)).data.ownerId == request.auth.uid;
        allow list: if isValidId(userId) && isValidId(chatId) &&
          isVerifiedOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(chatId) && isValidId(messageId) &&
          isVerifiedOwner(userId) &&
          isValidChatMessage(incoming(), userId, chatId, messageId) &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId)/chats/$(chatId)) &&
          get(/databases/$(database)/documents/users/$(userId)/chats/$(chatId)).data.ownerId == request.auth.uid;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(chatId) && isValidId(messageId) &&
          isVerifiedOwner(userId) && existing().ownerId == request.auth.uid;
      }
    }

    // Audit Payload Logs per user
    match /users/{userId}/payloadLogs/{logId} {
      allow get: if isValidId(userId) && isValidId(logId) && isVerifiedOwner(userId);
      allow list: if isValidId(userId) && isVerifiedOwner(userId) && existing().ownerId == request.auth.uid;
      allow create: if isValidId(userId) && isValidId(logId) && isVerifiedOwner(userId) &&
        isValidAuditPayload(incoming(), userId, logId) &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(userId) && isValidId(logId) && isVerifiedOwner(userId) && existing().ownerId == request.auth.uid;
    }
  }
}
